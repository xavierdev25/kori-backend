# DATABASE  (Supabase PostgreSQL Session Pooler)
# Session Pooler connection string (pgbouncer mode — for app queries)
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection (used by Prisma Migrate only)
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# SUPABASE STORAGE
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=notes

# ADMIN AUTH
ADMIN_USERNAME=<ADMIN_USERNAME>
# Generate with: node -e "const b=require('bcrypt');console.log(b.hashSync('<password>',12))"
ADMIN_PASSWORD_HASH=<BCRYPT_HASH>

# SEED (solo para `pnpm run prisma:seed`)
# Correo del usuario ADMIN que crea el seed en la tabla `users`.
# Si ADMIN_PASSWORD_HASH esta definido, el seed reutiliza ese hash y no
# cambia la contrasena. Si no, genera una aleatoria y la imprime UNA vez.
SEED_ADMIN_EMAIL=<ADMIN_EMAIL>

# JWT
# Minimum 32 characters — generate with: openssl rand -base64 48
JWT_SECRET=<MINIMUM_32_CHARS_RANDOM_SECRET>
JWT_EXPIRES_IN=2h
JWT_ISSUER=kori-backend
JWT_AUDIENCE=kori-dashboard

# Opcional: secreto dedicado a los tokens de acceso. Si falta, se usa
# JWT_SECRET. Minimo 32 caracteres.
# JWT_ACCESS_SECRET=

# Opcional: vida del token de acceso. Si falta, se usa JWT_EXPIRES_IN.
# Ahora que hay refresh token, lo recomendable es 15m, no 2h.
# JWT_ACCESS_EXPIRES_IN=15m
#
# El refresh token NO es un JWT ni necesita secreto: es un valor opaco
# aleatorio del que solo se guarda el hash SHA-256 en la tabla refresh_tokens.
# Asi se puede revocar de verdad, y filtrar la tabla no permite suplantar.

# COOKIES DE SESION (opcionales)
# El panel guarda la sesion en cookies httpOnly.
#
# OJO: el backend (onrender.com) y el panel (vercel.app) son sitios distintos,
# asi que SameSite=Lax NO envia la cookie y la sesion no funciona. Por eso en
# produccion el valor por defecto es "none" (que obliga a Secure).
# Con un dominio propio compartido (api.kori.mx + admin.kori.mx) poner "lax".
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# HMAC FINGERPRINT
# Minimum 32 characters — generate with: openssl rand -base64 48
HASH_PEPPER=<MINIMUM_32_CHARS_RANDOM_PEPPER>

# STRIPE (opcional — sin STRIPE_SECRET_KEY el checkout responde 503 y el resto
# del backend funciona igual, asi que se puede desplegar antes de tenerlo)
# La cuenta es de Stripe Mexico. Nunca poner aqui una clave pk_ (es publica).
# STRIPE_SECRET_KEY=sk_test_<...>
# Lo da Stripe al crear el endpoint de webhook. Obligatorio si hay clave.
# STRIPE_WEBHOOK_SECRET=whsec_<...>
# Paginas de retorno en la landing tras pagar o cancelar.
# STRIPE_SUCCESS_URL=https://<landing>/gracias
# STRIPE_CANCEL_URL=https://<landing>/checkout-cancelado

# CORREO (Resend) — opcional
# Sin RESEND_API_KEY los correos se escriben en el log en vez de enviarse, y
# el backend arranca igual. Resend solo entrega desde un dominio verificado:
# con el remitente de pruebas solo llegan correos a tu propia cuenta.
# RESEND_API_KEY=re_<...>
# RESEND_FROM_EMAIL=Kori <pedidos@tudominio.mx>
# A donde llegan las alertas de pedidos atascados y las peticiones de
# produccion manual. Sin esto, un pedido pagado que falle no avisa a nadie.
# ADMIN_ALERT_EMAIL=tu@correo.com

# COLA DE TRABAJOS
# Secreto del barrido externo (/internal/outbox/run). El mismo valor va en
# los secrets del repo de GitHub como INTERNAL_TASK_SECRET.
# Generar con: openssl rand -base64 36
# INTERNAL_TASK_SECRET=<SECRETO_LARGO_ALEATORIO>
# Cada cuanto revisa la cola el temporizador interno (ms, minimo 5000).
# OUTBOX_INTERVAL_MS=60000
# Poner en "false" para desactivar el temporizador interno (util en tests).
# OUTBOX_SCHEDULER=true

# COPIAS DE SEGURIDAD (secrets del repo en GitHub, no van aqui)
# El workflow backup.yml necesita dos secrets en GitHub:
#   DIRECT_URL         la conexion directa (no el pooler): pg_dump la exige
#   BACKUP_PASSPHRASE  frase para cifrar el volcado (openssl rand -base64 32)
# Sin BACKUP_PASSPHRASE no hay restauracion posible: guardala fuera de GitHub.

# CORS / ORIGINS
LANDING_ORIGIN=http://localhost:4321
DASHBOARD_ORIGIN=http://localhost:3000

# SERVER
PORT=4000
NODE_ENV=development

# OPTIONAL
# Enable structured HTTP request logs (true | false)
ENABLE_REQUEST_LOGGING=false

# Trust proxy hops (1 for one reverse proxy, e.g. Cloudflare)
# Leave unset when running locally without a proxy
TRUST_PROXY=

# STORAGE DRIVER (optional)
# local  = development only: files under ./uploads, no Supabase needed
# supabase (default) = requires the SUPABASE_* variables above
# STORAGE_DRIVER=local

# OBSERVABILITY (optional)
# Free-tier Sentry DSN; leave unset to disable error reporting
# SENTRY_DSN=
